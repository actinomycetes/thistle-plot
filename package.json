{
  "name": "thistle-plot",
  "version": "0.9.0",
  "private": true,
  "description": "Thistle Plot (TP): single-file stats and plotting web app for bench scientists (beta).",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=240000 \"tests/*.test.js\"",
    "test:quick": "node --test --test-timeout=240000 tests/smoke.test.js tests/links.test.js tests/replot.test.js",
    "help": "python3 tools/build_help.py",
    "help:check": "python3 tools/build_help.py --check"
  },
  "devDependencies": {
    "chart.js": "4.4.1",
    "jstat": "1.9.6",
    "papaparse": "5.4.1",
    "playwright": "^1.48.0"
  }
}
